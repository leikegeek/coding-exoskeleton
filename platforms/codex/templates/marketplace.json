{
  "name": "coding-local",
  "plugins": [
    {
      "name": "coding-exoskeleton",
      "source": {
        "source": "local",
        "path": "./plugins/coding-exoskeleton"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity",
      "interface": {
